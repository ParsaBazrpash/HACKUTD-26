# Public client selection. "mock" keeps shells in browser memory.
# "spacetimedb" constructs the SpacetimeDB client, which refuses calls
# until the module is published.
NEXT_PUBLIC_DATA_CLIENT=mock

# Browser websocket target for SpacetimeDB Maincloud. Not a secret.
# Set both when the module exists. Example URI shape: wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_DATABASE=

# Do not add private keys, channel keys, or incident content to this file.
