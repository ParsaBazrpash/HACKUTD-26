# Copy to .env.local for local work. Never commit real values.
#
# Two kinds of settings live here:
# 1. Public NEXT_PUBLIC_* values, which are built into the browser bundle.
# 2. Server-only pager settings, listed by name with an empty value. They are
#    read only by the pager routes (app/api/page, app/api/twilio/voice) and are
#    set as Secret or Config variables in Vercel, Production only. Never give a
#    secret a NEXT_PUBLIC_ name, and never put a real secret in this file.

# --- Public (browser) --------------------------------------------------------

# Set to 1 to run the UI on the in-browser mock (never set on Vercel).
NEXT_PUBLIC_ZH_MOCK=

# Spacetime Maincloud websocket host and database name.
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=zerohour-hackutd26

# Pager public key (ECDH P-256, base64url). Browsers seal phone numbers to it.
# Printed by `node scripts/pager-keys.mjs` together with PAGER_PRIVATE_KEY.
NEXT_PUBLIC_PAGER_PUB=

# Legacy names read by lib/data/env.ts until the UI moves to lib/client.
# Delete with that migration.
NEXT_PUBLIC_DATA_CLIENT=mock
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_DATABASE=

# --- Server only: pager (Vercel, Production) ---------------------------------

# Twilio Console home page, Account Info box. "AC" followed by 32 letters and digits. Secret.
TWILIO_ACCOUNT_SID=
# Same box. 32 letters and digits. Also used to check Twilio webhook signatures. Secret.
TWILIO_AUTH_TOKEN=
# The Twilio number that places pages and sends the page text, in E.164 form: +15551234567. Must have voice and SMS. Config.
TWILIO_FROM=

# Pager private key (ECDH P-256, pkcs8, base64url) from `node scripts/pager-keys.mjs`.
# It opens sealed phone numbers only, never incident content. Secret.
PAGER_PRIVATE_KEY=

# Org admin signing public keys the pager trusts (raw P-256, base64url),
# comma-separated with no spaces. Filled in after the org exists. Config.
ORG_ADMIN_SIGN_PUB=

# Token of the pager's own Spacetime identity, from
#   curl -sS -X POST https://maincloud.spacetimedb.com/v1/identity
# It may only write call status through the pager_update reducer. Secret.
SPACETIME_PAGER_TOKEN=
# HTTPS (not wss) Spacetime host and the database name, for reducer calls. Config.
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=zerohour-hackutd26

# Production URL with no trailing slash, e.g. https://example.vercel.app.
# Twilio webhooks must use it: Vercel protects preview URLs. Config.
PUBLIC_BASE_URL=

# Optional demo safety net: the only numbers the pager will ever call, E.164,
# comma-separated with no spaces. Leave empty to allow any certified number. Secret.
PAGER_ALLOWED_NUMBERS=

# Do not add private keys, channel keys, phone numbers, or incident content to this file.
