{
  "name": "hackutd-26",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p spacetimedb --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud zerohour-hackutd26 -y",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "test:live": "vitest run --config vitest.live.config.mts",
    "seed:demo": "vitest run --config vitest.seed.config.mts",
    "test:live:browser": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "d3-geo": "^3.1.2",
    "earcut": "^3.2.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "spacetimedb": "^2.14.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
